[Unit]
Description=VaultMCP master MCP server
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=vaultmcp
Group=vaultmcp
EnvironmentFile=/srv/vaultmcp/master.env
WorkingDirectory=/srv/vaultmcp
ExecStart=/usr/local/bin/vaultmcp-master serve
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/srv/vaultmcp
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
