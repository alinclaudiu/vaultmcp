# Copy to ~/.config/vaultmcp/agent.env on each server. Do NOT commit a filled-in copy.

# Required: where master is reachable.
VAULTMCP_MASTER_URL=http://master.internal:8080

# Required: identity for audit + future authorization.
VAULTMCP_SERVER_ID=server-1
VAULTMCP_APP=webstore

# Optional: override defaults.
VAULTMCP_VAULT_DIR=/home/vaultmcp/vault
VAULTMCP_STATE_DIR=/home/vaultmcp/.vaultmcp
VAULTMCP_AGENT_MODEL=claude-opus-4
VAULTMCP_POLL_INTERVAL=5
