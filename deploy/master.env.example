# Copy to /srv/vaultmcp/master.env (or wherever your systemd unit reads from)
# and fill in. Do NOT commit a filled-in copy.

# Required.
VAULTMCP_DATABASE_URL=postgres://vaultmcp:CHANGE_ME@localhost:5432/vaultmcp

# Where master writes rendered markdown files.
VAULTMCP_WIKI_DIR=/srv/vaultmcp/wiki

# Bind addresses. Default: localhost-only (for SSH-tunnel access in v0.2).
VAULTMCP_HTTP_HOST=127.0.0.1
VAULTMCP_HTTP_PORT=8080
