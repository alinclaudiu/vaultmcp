# Editor local files
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Secrets that shouldn't land here
*.env
.env.*
!.env.example
*.key
*.pem
*.p12
id_rsa
id_ed25519

# Build artifacts (when code lands)
__pycache__/
*.pyc
*.pyo
build/
dist/
*.egg-info/
node_modules/

# Virtual environments
.venv/
venv/
.uv-cache/

# Local databases (when code lands)
*.db
*.sqlite
*.sqlite3
*.dump
*.sql.gz
# Note: we deliberately do NOT ignore *.sql — schema migrations and
# fixtures live in the repo. Production dumps end with .sql.gz / .dump
# (covered above) or should be kept entirely outside the repo.

# Logs
*.log
logs/
/.ci-staging/
